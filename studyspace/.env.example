# Copy to .env and fill in real values. Never commit the real file.
# Every variable below is read by apps/api/app/core/config.py.

# development | test | production
ENVIRONMENT=development

# Required. Signing key for access tokens; the API refuses to start without it.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-value

# SQLite keeps local setup dependency-free. The models are PostgreSQL-ready,
# so switching to Postgres in production is a URL change plus a migration run.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/studyspace
DATABASE_URL=sqlite:///./var/studyspace.db

# Where uploaded file bytes are written by the local storage adapter.
STORAGE_DIR=./var/storage

# Comma-separated origins allowed to call the API directly.
CORS_ORIGINS=["http://localhost:3000"]

# Abuse protection (per user for uploads, per IP for login).
LOGIN_MAX_ATTEMPTS_PER_MINUTE=10
UPLOAD_MAX_ATTEMPTS_PER_MINUTE=30
WRITE_MAX_ATTEMPTS_PER_MINUTE=120

# Upload ceiling in bytes (default 10 MB).
UPLOAD_MAX_BYTES=10485760
